# ── REQUIRED ─────────────────────────────────────────────
# Get a free Groq API key at: https://console.groq.com/keys
# Free tier: 30 req/min, 14,400 req/day. No credit card. Fastest inference.
GROQ_API_KEY=paste_your_key_here

# ── OPTIONAL (all have sensible defaults) ────────────────
# Model choice on Groq. Options as of Aug 2026:
#   openai/gpt-oss-120b (default, best balance ~500 t/s)
#   openai/gpt-oss-20b (fastest ~1000 t/s, smaller model)
#   qwen/qwen3.6-27b (multimodal preview — may be discontinued)
# GROQ_MODEL=openai/gpt-oss-120b

# Rate limit (per IP address, per minute)
# MAX_REQUESTS_PER_MINUTE=15

# LLM generation tuning
# LLM_TEMPERATURE=1
# LLM_MAX_TOKENS=240
# LLM_TIMEOUT_SECONDS=15

# ── ALTERNATIVE PROVIDER (Gemini) ────────────────────────
# If you want to swap back to Gemini, set these AND swap the import
# in siddhikesh_agent/agent.py from GroqClient to GeminiClient.
# GEMINI_API_KEY=paste_your_key_here
# GEMINI_MODEL=gemini-2.0-flash
